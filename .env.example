# Strict Free-plan voice demo. Never commit the populated .env file.
# Use a restricted, expiring key with an account-side hard credit quota. It must
# allow Realtime Scribe token creation and read-only subscription preflight;
# grant no generation/TTS permissions.
ELEVENLABS_API_KEY=

# After checking the dashboard, set this blank field to the exact value
# I_CONFIRM_NO_PAYG_OR_AUTO_TOP_UP. Leaving it blank keeps the app fail-closed;
# copying this example must never acknowledge billing settings automatically.
ELEVENLABS_FREE_TIER_ACKNOWLEDGEMENT=

# Required bearer for the public voice WebSocket. Generate a long random value,
# keep it out of source/video captures, and send it only inside the TLS-protected
# start message as demo_token. A blank value makes voice fail closed.
VOICE_DEMO_TOKEN=

# Exact browser origins, without trailing slashes. Keep origin enforcement on
# for a public demo. Add the deployed HTTPS origin before starting the service.
ELEVENLABS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ELEVENLABS_REQUIRE_ORIGIN=true

# Pre-provider abuse and memory bounds. Run one worker for the process-local
# rate limiter, or replace it with shared storage before a multi-worker deploy.
VOICE_DEMO_MAX_FRAME_BYTES=16000
VOICE_DEMO_SESSIONS_PER_MINUTE=6
VOICE_DEMO_RATE_LIMIT_WINDOW_SECONDS=60

# Process-local safety ceilings. They reset when the process restarts, so the
# provider-side Free/PAYG checks above remain mandatory.
ELEVENLABS_DEMO_MAX_AUDIO_SECONDS=15
ELEVENLABS_DEMO_MAX_CONCURRENT_SESSIONS=1
ELEVENLABS_DEMO_DAILY_SESSION_CAP=20
ELEVENLABS_DEMO_DAILY_TOKEN_CAP=25

# Warm local retrieval and zero-cost extractive generation.
RAG_INDEX_DIR=data/faiss_index
RAG_PRELOAD=true
RAG_DEVICE=
RAG_CPU_THREADS=2
RAG_LATENCY_TARGET_MS=200

# Historical standalone benchmarks only. Leave blank for the strict Free demo;
# the live harness has no Sarvam or Groq fallback.
SARVAM_API_KEY=
GROQ_API_KEY=

# Optional for higher Hugging Face Hub rate limits or gated tokenizer models
HF_TOKEN=

# Historical Sarvam benchmark default
SARVAM_LANGUAGE_CODE=en-IN
