# Required provider credentials. Never commit populated values.
SARVAM_API_KEY=
GROQ_API_KEY=

# Required bearer for /ws/voice-rag. Generate 32+ random bytes and send the
# value only in the TLS-protected start message. A blank value fails closed.
VOICE_DEMO_TOKEN=

# Exact browser origins without trailing slashes. Keep enforcement enabled on
# any public service. Add the final HTTPS deployment origin before startup.
VOICE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
VOICE_REQUIRE_ORIGIN=true

# Voice input and process-local abuse bounds. Use one ASGI worker unless the
# rate limiter is moved to shared storage.
VOICE_DEMO_MAX_FRAME_BYTES=16000
VOICE_DEMO_SESSIONS_PER_MINUTE=6
VOICE_DEMO_RATE_LIMIT_WINDOW_SECONDS=60
VOICE_MAX_AUDIO_SECONDS=30

# Sarvam realtime manual-commit behavior.
SARVAM_SILENCE_DURATION_MS=100
SARVAM_MAX_ATTEMPTS=3

# Warm local index and embedding runtime.
RAG_INDEX_DIR=data/faiss_index
RAG_PRELOAD=true
RAG_DEVICE=
RAG_CPU_THREADS=2
RAG_LATENCY_TARGET_MS=200

# Groq is a fallback only when the exact-evidence generator refuses and this
# much request budget remains. The 350 ms default comes from the measured Groq
# P100 and therefore prevents remote fallback under a 200 ms serving target.
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_OUTPUT_TOKENS=96
GROQ_MAX_ATTEMPTS=2
GROQ_MIN_FALLBACK_BUDGET_MS=350

# Optional for dataset/model Hub access and required by deploy_hf_space.py.
HF_TOKEN=
